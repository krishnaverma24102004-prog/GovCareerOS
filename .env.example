# Copy to .env and fill in. .env is git-ignored.
POSTGRES_SUPERUSER_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/govcareeros
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/govcareeros_test
REDIS_URL=redis://localhost:6379/0

# ollama (local) or nvidia. LLM_MODEL is the Ollama model; NVIDIA uses NVIDIA_MODELS below.
LLM_PROVIDER=ollama
LLM_MODEL=huihui_ai/qwen3-abliterated:8b-v2-q4_K_M
OLLAMA_URL=http://127.0.0.1:11434
GOOGLE_API_KEY=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

STORAGE_PATH=./storage
PLAYWRIGHT_HEADLESS=true

# NVIDIA build.nvidia.com API key (paste after =, no quotes). Used only for public notice text.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Comma-separated, tried in order; a model the API reports retired (404/410) is skipped for the run.
# nvidia/nemotron-3-super-120b-a12b was retired on 2026-10-03.
NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_REQUESTS_PER_MINUTE=40

# --- Production / docker compose (docker-compose.yml, docs/deploy/README.md) ---
# Password of the "govcareeros" database user in the compose stack (any characters; passed to the app as DATABASE_PASSWORD)
POSTGRES_PASSWORD=
# Optional; uncomment to change a default. An empty value is NOT a default (an empty SCHEDULE_* turns the job off).
# Allowed browser origins: FRONTEND_ORIGIN plus FRONTEND_ORIGINS (comma-separated); explicit origins, never *
# FRONTEND_ORIGIN=http://localhost:3000
# FRONTEND_ORIGINS=
# The API as the browser sees it; compiled into the dashboard image at build time
# NEXT_PUBLIC_API_URL=http://localhost:8080
# FORWARDED_ALLOW_IPS=*
# MAX_REQUEST_BYTES=1048576
# HSTS_SECONDS=31536000
# json in the images (one redacted JSON object per line), text locally
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Scheduler container: "HH:MM" daily or "mon HH:MM" weekly; empty = off
# SCHEDULE_UTC_OFFSET=+05:30
# SCHEDULE_DAILY_JOB=07:00
# SCHEDULE_SEND_DIGESTS=mon 08:00
# SCHEDULE_TRIAGE=
# SCHEDULE_DIGEST_SEND=false
